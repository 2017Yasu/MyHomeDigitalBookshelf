{
  "name": "my-home-digital-bookshelf-client-apps",
  "version": "1.0.0",
  "description": "Client applications for My Home Digital Bookshelf",
  "main": "index.js",
  "scripts": {
    "apps/mobile": "pnpm -C 'apps/mobile'",
    "apps/web": "pnpm -C 'apps/web'",
    "common/ui": "pnpm -C 'common/ui'",
    "format": "prettier --write .",
    "lint": "pnpm -C 'apps/web' lint && pnpm -C 'apps/mobile' lint",
    "lint:fix": "pnpm -C 'apps/web' lint --fix && pnpm -C 'apps/mobile' lint --fix",
    "type-check": "pnpm -C 'apps/web' type-check && pnpm -C 'apps/mobile' type-check && pnpm -C 'common/ui' type-check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "volta": {
    "node": "24.12.0"
  }
}
